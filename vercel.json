{
  "services": {
    "web": {
      "root": ".",
      "framework": "vite",
      "installCommand": "npx -y pnpm@10 install --dir admincore-dashboard",
      "buildCommand": "cd admincore-dashboard && npm run build",
      "outputDirectory": "admincore-dashboard/dist"
    },
    "api": {
      "root": "api",
      "framework": "express",
      "entrypoint": "index.ts",
      "installCommand": "cd ../backend && npm install --omit=dev"
    }
  },
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": { "service": "api" } },
    { "source": "/api/health", "destination": { "service": "api" } },
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}