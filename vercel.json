{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npx -y pnpm@10 install --dir admincore-dashboard && cd backend && npm install --omit=dev",
  "buildCommand": "cd admincore-dashboard && npm run build",
  "outputDirectory": "admincore-dashboard/dist",
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": "/api/index" },
    { "source": "/api/health", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
